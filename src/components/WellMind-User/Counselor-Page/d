import { AnimatePresence, motion } from 'framer-motion';
import { useState } from 'react';
import { Button } from '@/components/ui/button';
import {
  Briefcase,
  CalendarDays,
  CalendarPlus,
  Clock,
  Info,
  MessageCircle,
  Star,
  Video,
  X,
  Users,
  Pencil,
  ChevronRight,
  Shield,
} from 'lucide-react';
import { BottomNav } from '@/components/WellMind-User/BottomNav';
import { CounselorAvatar, getStatusColor, getStatusPillClass } from './CounselorAvatar';
import { BookingModal } from './BookingModal';
import { CounselorProfileView } from './CounselorProfileView';
import { formatDate, formatDateTime, formatMessageContent, formatTime } from './CounselorSupportChat.utils';
import type { CounselorChat, CounselorUser } from '@/types/wellmind';
import type { CounsellorAppointment } from '@/stores/counselorChatStore';

interface CounselorBrowseViewProps {
  embedded?: boolean;
  userName?: string;
  counselorProfile: CounselorUser | null;
  onlineNow: number;
  visibleAppointments: CounsellorAppointment[];
  chats: CounselorChat[];
  availableCounselors: CounselorUser[];
  bookingCounselor: CounselorUser | null;
  setActiveChatId: (chatId: string) => void;
  setView: (view: 'setup' | 'counselors' | 'chat') => void;
  handleStartChat: (counselor: CounselorUser) => void;
  setBookingCounselor: (counselor: CounselorUser | null) => void;
  cancelAppointment: (id: string) => void;
  onBooked: (counselor: CounselorUser) => void;
}

const statusLabel: Record<string, string> = {
  online: 'Available',
  away: 'Away',
  busy: 'In Session',
};

const AppointmentStatusBadge = ({ status }: { status: string }) => {
  const styles: Record<string, string> = {
    requested: 'bg-amber-50 text-amber-600 border border-amber-200',
    confirmed: 'bg-emerald-50 text-emerald-600 border border-emerald-200',
    completed: 'bg-slate-100 text-slate-500 border border-slate-200',
    cancelled: 'bg-red-50 text-red-400 border border-red-200',
    missed: 'bg-orange-50 text-orange-500 border border-orange-200',
  };
  return (
    <span className={`inline-block text-[10px] uppercase tracking-widest font-semibold px-2.5 py-1 rounded-full ${styles[status] ?? styles.requested}`}>
      {status}
    </span>
  );
};

export const CounselorBrowseView = ({
  embedded = false,
  userName,
  counselorProfile,
  onlineNow,
  visibleAppointments,
  chats,
  availableCounselors,
  bookingCounselor,
  setActiveChatId,
  setView,
  handleStartChat,
  setBookingCounselor,
  cancelAppointment,
  onBooked,
}: CounselorBrowseViewProps) => {
  const [selectedCounselor, setSelectedCounselor] = useState<CounselorUser | null>(null);

  return (
    <div className={embedded ? '' : 'min-h-screen pb-28'} style={{ background: 'linear-gradient(180deg, #f0f7f5 0%, #f7faf9 60%, #ffffff 100%)' }}>

    {/* ── Hero banner ── */}
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      className="relative overflow-hidden px-5 pt-10 pb-8"
    >
      {/* Soft background rings */}
      <div className="pointer-events-none absolute -top-20 -right-20 w-72 h-72 rounded-full"
        style={{ background: 'radial-gradient(circle, rgba(57,168,155,0.13) 0%, transparent 70%)' }} />
      <div className="pointer-events-none absolute top-10 -left-16 w-56 h-56 rounded-full"
        style={{ background: 'radial-gradient(circle, rgba(232,115,90,0.08) 0%, transparent 70%)' }} />

      <motion.div initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.05 }}>
        <div className="flex items-center gap-2 mb-3">
          <div className="w-8 h-8 rounded-xl flex items-center justify-center" style={{ background: '#39a89b' }}>
            <Users className="h-4 w-4 text-white" />
          </div>
          <span className="text-xs font-semibold uppercase tracking-widest" style={{ color: '#39a89b' }}>Counselor Support</span>
        </div>

        <h1 className="text-[2rem] font-bold leading-tight mb-2" style={{ color: '#1a2b38', letterSpacing: '-0.02em' }}>
          You are not alone.
        </h1>
        <p className="text-[15px] leading-relaxed mb-6" style={{ color: '#5f7585' }}>
          Connect with a trained counselor — private, safe, and judgment-free.
        </p>

        {/* Stats row */}
        <div className="flex gap-3">
          {[
            { value: onlineNow, label: 'Online now', accent: '#39a89b' },
            { value: chats.length, label: 'Active chats', accent: '#e8735a' },
            { value: visibleAppointments.length, label: 'Sessions', accent: '#6bab9e' },
          ].map((item, i) => (
            <motion.div
              key={item.label}
              initial={{ opacity: 0, y: 12 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.12 + i * 0.07 }}
              className="flex-1 rounded-2xl px-3 py-4 text-center"
              style={{ background: 'white', boxShadow: '0 2px 12px rgba(0,0,0,0.06)' }}
            >
              <p className="text-2xl font-bold leading-none mb-1" style={{ color: item.accent }}>{item.value}</p>
              <p className="text-[11px] font-medium" style={{ color: '#8fa3b1' }}>{item.label}</p>
            </motion.div>
          ))}
        </div>
      </motion.div>
    </motion.div>

    <main className="px-5 space-y-6">

      {/* ── Identity strip ── */}
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ delay: 0.2 }}
        className="flex items-center justify-between rounded-2xl px-4 py-3"
        style={{ background: 'rgba(57,168,155,0.07)', border: '1px solid rgba(57,168,155,0.15)' }}
      >
        <div className="flex items-center gap-2">
          <Shield className="h-3.5 w-3.5" style={{ color: '#39a89b' }} />
          <p className="text-sm" style={{ color: '#3d6b64' }}>
            {counselorProfile?.isAnonymous
              ? 'Chatting anonymously'
              : `Chatting as ${counselorProfile?.displayName || userName || 'User'}`}
          </p>
        </div>
        <button
          onClick={() => setView('setup')}
          className="flex items-center gap-1 text-xs font-semibold rounded-full px-3 py-1 transition-colors"
          style={{ color: '#39a89b', background: 'rgba(57,168,155,0.1)' }}
        >
          <Pencil className="h-3 w-3" />
          Edit
        </button>
      </motion.div>

      {/* ── Active Conversations ── */}
      {chats.length > 0 && (
        <motion.section initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.22 }}>
          <SectionHeading>Your Conversations</SectionHeading>
          <div className="space-y-2.5">
            {chats.map((chat, i) => {
              const counselor = availableCounselors.find((p) => chat.participants.includes(p.id));
              if (!counselor) return null;
              const lastMessage = chat.messages[chat.messages.length - 1];
              return (
                <motion.button
                  key={chat.id}
                  initial={{ opacity: 0, x: -10 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ delay: i * 0.06 }}
                  onClick={() => { setActiveChatId(chat.id); setView('chat'); }}
                  whileTap={{ scale: 0.985 }}
                  className="w-full rounded-2xl p-4 flex items-center gap-3.5 text-left transition-all"
                  style={{ background: 'white', boxShadow: '0 2px 10px rgba(0,0,0,0.055)' }}
                >
                  <div className="relative flex-shrink-0">
                    <CounselorAvatar counselor={counselor} size="md" />
                    <div className={`absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full border-2 border-white ${getStatusColor(counselor.status)}`} />
                  </div>
                  <div className="flex-1 min-w-0">
                    <p className="font-semibold text-sm" style={{ color: '#1a2b38' }}>{counselor.displayName}</p>
                    {lastMessage && (
                      <p className="text-xs truncate mt-0.5" style={{ color: '#8fa3b1' }}>
                        {formatMessageContent(lastMessage.content)}
                      </p>
                    )}
                  </div>
                  <div className="flex flex-col items-end gap-1.5 flex-shrink-0">
                    <span className="text-[11px]" style={{ color: '#b0c0cc' }}>
                      {formatTime(chat.lastMessageAt)}
                    </span>
                    <ChevronRight className="h-3.5 w-3.5" style={{ color: '#c8d8e0' }} />
                  </div>
                </motion.button>
              );
            })}
          </div>
        </motion.section>
      )}

      {/* ── Upcoming Sessions ── */}
      {visibleAppointments.length > 0 && (
        <motion.section initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.26 }}>
          <SectionHeading icon={<CalendarDays className="h-4 w-4" style={{ color: '#e8735a' }} />}>
            Upcoming Sessions
          </SectionHeading>
          <div className="space-y-2.5">
            {visibleAppointments
              .sort((a, b) => new Date(a.appointmentDate).getTime() - new Date(b.appointmentDate).getTime())
              .map((appt, i) => {
                const counselor = availableCounselors.find((p) => p.id === appt.counselorId);
                if (!counselor) return null;
                return (
                  <motion.div
                    key={appt.id}
                    initial={{ opacity: 0, y: 8 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: i * 0.06 }}
                    className="rounded-2xl p-4 flex items-center gap-3.5"
                    style={{ background: 'white', boxShadow: '0 2px 10px rgba(0,0,0,0.055)' }}
                  >
                    {/* Type icon */}
                    <div
                      className="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0"
                      style={{ background: appt.consultationType === 'video' ? 'rgba(107,171,158,0.12)' : 'rgba(232,115,90,0.1)' }}
                    >
                      {appt.consultationType === 'video'
                        ? <Video className="h-5 w-5" style={{ color: '#6bab9e' }} />
                        : <MessageCircle className="h-5 w-5" style={{ color: '#e8735a' }} />}
                    </div>

                    <div className="flex-1 min-w-0">
                      <p className="font-semibold text-sm mb-0.5" style={{ color: '#1a2b38' }}>{counselor.displayName}</p>
                      <p className="text-xs mb-1.5" style={{ color: '#8fa3b1' }}>
                        {formatDateTime(appt.appointmentDate, appt.slot)}
                      </p>
                      <AppointmentStatusBadge status={appt.status} />
                    </div>

                    <button
                      onClick={() => cancelAppointment(appt.id)}
                      className="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 transition-colors hover:bg-red-50"
                      style={{ color: '#c8d5dd' }}
                    >
                      <X className="h-4 w-4" />
                    </button>
                  </motion.div>
                );
              })}
          </div>
        </motion.section>
      )}

      {/* ── Available Counselors ── */}
      <motion.section initial={{ opacity: 0, y: 16 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}>
        <SectionHeading>Available Counselors</SectionHeading>

        <div className="space-y-4">
          {availableCounselors.map((counselor, index) => {
            const isOnline = counselor.status === 'online';
            const isBusy = counselor.status === 'busy';

            return (
              <motion.div
                key={counselor.id}
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.32 + index * 0.08, type: 'spring', stiffness: 260, damping: 24 }}
                className="rounded-3xl overflow-hidden"
                style={{ background: 'white', boxShadow: '0 4px 20px rgba(0,0,0,0.07)' }}
              >
                {/* Top accent line */}
                <div
                  className="h-1 w-full"
                  style={{
                    background: isOnline
                      ? 'linear-gradient(90deg, #39a89b, #6bab9e)'
                      : isBusy
                      ? 'linear-gradient(90deg, #e8735a, #f0957f)'
                      : 'linear-gradient(90deg, #c8d8e0, #dce8ed)',
                  }}
                />

                <div className="p-5">
                  {/* Header row */}
                  <div className="flex items-start gap-4 mb-4">
                    <div className="relative flex-shrink-0">
                      <CounselorAvatar counselor={counselor} size="lg" />
                      <div
                        className={`absolute -bottom-0.5 -right-0.5 w-4 h-4 rounded-full border-2 border-white ${getStatusColor(counselor.status)}`}
                      />
                    </div>

                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-2 flex-wrap mb-1">
                        <h3 className="text-lg font-bold leading-tight" style={{ color: '#1a2b38' }}>
                          {counselor.displayName}
                        </h3>
                        <span
                          className="text-[11px] font-semibold px-2.5 py-0.5 rounded-full"
                          style={{
                            background: isOnline ? 'rgba(57,168,155,0.1)' : isBusy ? 'rgba(232,115,90,0.1)' : 'rgba(0,0,0,0.05)',
                            color: isOnline ? '#39a89b' : isBusy ? '#e8735a' : '#8fa3b1',
                          }}
                        >
                          {statusLabel[counselor.status] ?? counselor.status}
                        </span>
                      </div>

                      {counselor.specialization && (
                        <p className="text-xs flex items-center gap-1 mb-1" style={{ color: '#e8735a' }}>
                          <Briefcase className="h-3 w-3 flex-shrink-0" />
                          {counselor.specialization}
                        </p>
                      )}

                      <div className="flex items-center gap-3 text-xs" style={{ color: '#8fa3b1' }}>
                        {counselor.rating !== undefined && (
                          <span className="flex items-center gap-1">
                            <Star className="h-3 w-3 fill-amber-400 text-amber-400" />
                            <span className="font-semibold" style={{ color: '#5f7585' }}>{counselor.rating.toFixed(1)}</span>
                          </span>
                        )}
                        {counselor.experienceYears !== undefined && counselor.experienceYears > 0 && (
                          <span>{counselor.experienceYears} yrs experience</span>
                        )}
                      </div>
                    </div>
                  </div>

                  {/* Bio */}
                  {(counselor.bio || counselor.specialization) && (
                    <p className="text-sm leading-relaxed mb-4" style={{ color: '#5f7585' }}>
                      {counselor.bio || counselor.specialization}
                    </p>
                  )}

                  {/* Topic chips */}
                  {counselor.supportTopics.length > 0 && (
                    <div className="flex flex-wrap gap-1.5 mb-5">
                      {counselor.supportTopics.map((topic) => (
                        <span
                          key={topic}
                          className="text-xs px-2.5 py-1 rounded-full font-medium"
                          style={{ background: 'rgba(57,168,155,0.09)', color: '#3d7a72' }}
                        >
                          {topic}
                        </span>
                      ))}
                    </div>
                  )}

                  {/* Action buttons */}
                  <div className="flex flex-col gap-2 sm:flex-row">
                    <motion.button
                      whileTap={{ scale: 0.96 }}
                      onClick={() => handleStartChat(counselor)}
                      disabled={isBusy}
                      className="flex-1 flex items-center justify-center gap-2 h-11 rounded-2xl text-sm font-semibold transition-all disabled:opacity-40"
                      style={{
                        background: isBusy ? '#f0f4f6' : 'linear-gradient(135deg, #e8735a 0%, #d45f47 100%)',
                        color: isBusy ? '#9ab0bc' : 'white',
                        boxShadow: isBusy ? 'none' : '0 4px 14px rgba(232,115,90,0.28)',
                      }}
                    >
                      <MessageCircle className="h-4 w-4" />
                      {isBusy ? 'In Session' : 'Start Chat'}
                    </motion.button>

                    <div className="flex gap-2">
                      <motion.button
                        whileTap={{ scale: 0.96 }}
                        onClick={() => setSelectedCounselor(counselor)}
                        className="flex-1 flex items-center justify-center gap-2 h-11 rounded-2xl text-sm font-semibold border-2 transition-all"
                        style={{
                          borderColor: 'rgba(57,168,155,0.3)',
                          color: '#39a89b',
                          background: 'rgba(57,168,155,0.05)',
                        }}
                      >
                        <Info className="h-4 w-4" />
                        View profile
                      </motion.button>
                      <motion.button
                        whileTap={{ scale: 0.96 }}
                        onClick={() => setBookingCounselor(counselor)}
                        className="flex-1 flex items-center justify-center gap-2 h-11 rounded-2xl text-sm font-semibold border-2 transition-all"
                        style={{
                          borderColor: 'rgba(57,168,155,0.3)',
                          color: '#39a89b',
                          background: 'rgba(57,168,155,0.05)',
                        }}
                      >
                        <CalendarPlus className="h-4 w-4" />
                        Book Session
                      </motion.button>
                    </div>
                  </div>
                </div>
              </motion.div>
            );
          })}
        </div>
      </motion.section>

      {/* Bottom padding for nav */}
      <div className="h-4" />
    </main>

    <AnimatePresence>
      {selectedCounselor && (
        <CounselorProfileView counselor={selectedCounselor} onClose={() => setSelectedCounselor(null)} />
      )}
      {bookingCounselor && (
        <BookingModal
          counselor={bookingCounselor}
          onClose={() => setBookingCounselor(null)}
          onBooked={() => onBooked(bookingCounselor)}
        />
      )}
    </AnimatePresence>

    {!embedded && <BottomNav />}
  </div>
  );
};

// ── Helpers ──────────────────────────────────────────────────────────────────

const SectionHeading = ({
  children,
  icon,
}: {
  children: React.ReactNode;
  icon?: React.ReactNode;
}) => (
  <div className="flex items-center gap-2 mb-3 px-0.5">
    {icon}
    <h2 className="text-base font-bold" style={{ color: '#1a2b38', letterSpacing: '-0.01em' }}>
      {children}
    </h2>
  </div>
);